# Copiá este archivo como .env y completá UNA de las dos claves.
LLM_PROVIDER=anthropic          # anthropic | openai
LLM_MODEL=claude-sonnet-5-5     # o gpt-4o-mini si usás OpenAI
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Opcional: un modelo distinto por rol (ej. supervisor más capaz, especialistas más baratos).
# Si no se definen, todos usan LLM_MODEL.
# LLM_MODEL_SUPERVISOR=claude-sonnet-5-5
# LLM_MODEL_INVESTIGADOR=claude-haiku-5-5
# LLM_MODEL_ANALISTA=claude-haiku-5-5
# LLM_MODEL_SINTETIZADOR=claude-haiku-5-5
